# Nama storage account Azure (tanpa .blob.core.windows.net)
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER_BRONZE=bronze

# Jendela rolling: setiap run memproses N hari terakhir (termasuk hari ini)
LOOKBACK_DAYS=2

# Kosong = semua stasiun. Contoh: 11525670,11150500
STATIONS=

# Opsional. USGS tetap bisa diakses tanpa key (kuota lebih kecil).
USGS_API_KEY=
